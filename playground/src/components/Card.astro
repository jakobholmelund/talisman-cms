---
import { getMediaImageSrcSet } from 'talisman-cms/helpers';

interface Props {
  title?: string;
  subtitle?: string;
  image?: string;
  imageTransitionName?: string;
  href?: string;
  class?: string;
}

const { title, subtitle, image, imageTransitionName, href, class: className = '' } = Astro.props;

const CardTag = href ? 'a' : 'div';
---

<CardTag 
  href={href} 
  class={`group flex flex-col overflow-hidden rounded-2xl glass transition-all hover:shadow-2xl hover:-translate-y-1 ${href ? 'cursor-pointer' : ''} ${className}`}
>
  {image && (
    <div class="relative w-full h-48 sm:h-64 overflow-hidden bg-brand-50">
      <img 
        src={image} 
        srcset={getMediaImageSrcSet(image)}
        sizes="(min-width: 1280px) 280px, (min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
        alt={title || 'Card Cover'} 
        width="800"
        height="600"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
        transition:name={imageTransitionName}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>
  )}
  <div class="flex flex-col flex-grow p-6">
    <slot name="header">
      {subtitle && <p class="text-xs font-semibold uppercase tracking-wider text-brand-600 mb-2">{subtitle}</p>}
      {title && <h3 class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-900 to-gray-700 leading-tight mb-3 group-hover:text-brand-600 transition-colors">{title}</h3>}
    </slot>
    <div class="mt-auto pt-4 text-text-muted text-sm space-y-4">
      <slot />
    </div>
  </div>
</CardTag>
