---
import { getCollectionRepeaterViewModel } from 'talisman-cms/helpers';
import { richTextToPlainText } from 'talisman-cms/richtext';
import { getContainerClass, getSectionClass, getTheme } from './shared';

const { rendererContext = {}, items, index = 0 } = Astro.props;
const postsById = rendererContext.postsById || {};
const repeater = getCollectionRepeaterViewModel(Astro.props);
const fallbackPosts = (items || []).map((id: string) => postsById[id]).filter(Boolean);
const posts = repeater.items.length > 0 ? repeater.items : fallbackPosts;
const isListLayout = repeater.layout === 'list';
---

<section class={getSectionClass(Astro.props, 'py-20', true, index)} data-theme={getTheme(Astro.props)}>
  <div class={getContainerClass(Astro.props, 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8')}>
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        {repeater.eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-600">{repeater.eyebrow}</p>}
        <h2 class="mt-3 text-3xl font-black tracking-tight text-gray-900">{repeater.title}</h2>
        {repeater.description && <p class="mt-4 text-base leading-relaxed text-gray-500">{repeater.description}</p>}
      </div>
      {repeater.cta && (
        <a href={repeater.cta.href} class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-900 transition-colors hover:border-brand-200 hover:text-brand-700">
          {repeater.cta.label}
        </a>
      )}
    </div>

    {posts.length === 0 ? (
      <div class="mt-10 rounded-[2rem] border border-dashed border-gray-200 bg-gray-50 px-8 py-12 text-center text-sm text-gray-500">
        {repeater.emptyMessage}
      </div>
    ) : (
      <div class={isListLayout ? 'mt-10 space-y-4' : 'mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3'}>
        {posts.map((post: any) => {
          const authorName = post.data.author?.data?.name || 'Talisman Team';
          const publishDate = post.data.publishedAt
            ? new Date(post.data.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
            : 'Recently';
          const contentPreview = richTextToPlainText(post.data.content).slice(0, 140);

          return (
            <a
              href={`/blog/${post.slug}`}
              class={isListLayout
                ? 'group flex flex-col gap-4 rounded-[2rem] border border-gray-200 bg-white p-6 shadow-sm transition-transform hover:-translate-y-0.5 md:flex-row md:items-start'
                : 'group rounded-[2rem] border border-gray-200 bg-white p-6 shadow-lg transition-transform hover:-translate-y-1'}
            >
              <div class={isListLayout ? 'md:flex-1' : ''}>
                <div class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-600">Article</div>
                <h3 class="mt-3 text-xl font-bold leading-tight text-gray-900 transition-colors group-hover:text-brand-700">{post.data.title}</h3>
                {contentPreview && <p class="mt-3 text-sm leading-relaxed text-gray-500">{contentPreview}...</p>}
                <div class="mt-5 flex flex-wrap items-center gap-3 text-xs text-gray-500">
                  <span class="font-medium text-gray-900">{authorName}</span>
                  <span class="text-gray-300">•</span>
                  <time>{publishDate}</time>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</section>
