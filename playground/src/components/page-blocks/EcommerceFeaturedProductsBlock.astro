---
import { getMediaImageSrcSet } from 'talisman-cms/helpers';
import { getContainerClass, getProductHref, getProductImage, getSectionClass, getTheme } from './shared';

const { rendererContext = {}, productIds = [], columns = '3', index = 0 } = Astro.props;
const productsById = rendererContext.productsById || {};
const products = productIds.map((id: string) => productsById[id]).filter(Boolean);
const columnClass = columns === '2' ? 'lg:grid-cols-2' : columns === '4' ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---

<section class={getSectionClass(Astro.props, 'py-20', true, index)} data-theme={getTheme(Astro.props)}>
  <div class={getContainerClass(Astro.props, 'max-w-7xl mx-auto px-4 sm:px-6 lg:px-8')}>
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div class="max-w-2xl">
        {Astro.props.eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-600">{Astro.props.eyebrow}</p>}
        {Astro.props.title && <h2 class="mt-3 text-3xl font-black tracking-tight text-gray-900">{Astro.props.title}</h2>}
        {Astro.props.description && <p class="mt-4 text-base leading-relaxed text-gray-500">{Astro.props.description}</p>}
      </div>
      <a href={Astro.props.ctaHref || '/shop'} class="inline-flex items-center justify-center rounded-full border border-gray-200 bg-white px-5 py-3 text-sm font-semibold text-gray-900 transition-colors hover:border-brand-200 hover:text-brand-700">
        {Astro.props.ctaLabel || 'Browse catalog'}
      </a>
    </div>

    <div class={`mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 ${columnClass}`}>
      {products.map((product: any) => {
        const imageUrl = getProductImage(product);
        const price = ((product.data.basePrice || 0) / 100).toFixed(2);
        return (
          <a href={getProductHref(product)} class="group overflow-hidden rounded-[2rem] border border-gray-200 bg-white shadow-lg transition-transform hover:-translate-y-1">
            <div class="aspect-[4/3] bg-gray-100">
              {imageUrl ? (
                <img src={imageUrl} srcset={getMediaImageSrcSet(imageUrl)} sizes="(min-width: 1280px) 280px, (min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw" alt={product.data.name} width="800" height="600" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="flex h-full items-center justify-center text-sm font-medium text-gray-400">No image</div>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900">{product.data.name}</h3>
              {product.data.description && <p class="mt-3 text-sm leading-relaxed text-gray-500">{product.data.description}</p>}
              <div class="mt-5 flex items-center justify-between">
                <span class="text-sm font-semibold uppercase tracking-[0.25em] text-brand-600">${price}</span>
                <span class="text-sm font-medium text-gray-900">View product</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
