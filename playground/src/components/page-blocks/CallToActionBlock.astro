---
import { getContainerClass, getSectionClass, getTheme } from './shared';

const { eyebrow, title, description, primaryHref, primaryLabel, secondaryHref, secondaryLabel, index = 0 } = Astro.props;
---

<section class={getSectionClass(Astro.props, 'py-16', true, index)} data-theme={getTheme(Astro.props)}>
  <div class={getContainerClass(Astro.props, 'max-w-6xl mx-auto px-4 sm:px-6 lg:px-8')}>
    <div class="rounded-[2rem] bg-gray-900 px-8 py-10 text-white shadow-2xl sm:px-10 lg:flex lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-200">{eyebrow}</p>}
        <h2 class="mt-3 text-3xl font-black tracking-tight">{title}</h2>
        {description && <p class="mt-4 text-base leading-relaxed text-gray-300">{description}</p>}
      </div>
      <div class="mt-6 flex flex-wrap gap-3 lg:mt-0 lg:justify-end">
        <a href={primaryHref || '/shop'} class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-gray-900 transition-colors hover:bg-brand-100">
          {primaryLabel || 'Get started'}
        </a>
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="inline-flex items-center justify-center rounded-full border border-white/20 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-white/40 hover:bg-white/5">
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
