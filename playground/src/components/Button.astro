---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { 
  href, 
  variant = 'primary', 
  size = 'md', 
  class: className = '',
  type = 'button' 
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center rounded-full font-medium transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 disabled:pointer-events-none disabled:opacity-50 w-fit cursor-pointer active:scale-95";

const variants = {
  primary: "bg-brand-600 text-white shadow-md hover:bg-brand-700 hover:shadow-lg hover:-translate-y-0.5",
  secondary: "bg-brand-100 text-brand-900 shadow-sm hover:bg-brand-200",
  outline: "border border-brand-200 bg-transparent text-brand-900 hover:bg-brand-50 hover:text-brand-900 shadow-sm",
  ghost: "hover:bg-brand-100/50 hover:text-brand-900 text-text-muted"
};

const sizes = {
  sm: "h-8 px-3 text-xs",
  md: "h-10 px-6 py-2 text-sm",
  lg: "h-12 px-8 text-base"
};

const classes = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className}`;
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
