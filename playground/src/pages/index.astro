---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import { getClient } from 'talisman-cms/client';
import { env as cfEnv } from 'cloudflare:workers';
import { formatMoney, getStoreCurrency } from '../lib/commerce';

const env = { DB: (cfEnv as any).DB, KV: (cfEnv as any).KV };
const cms = getClient(env);
const currency = getStoreCurrency(cfEnv as any);

const [products, posts] = await Promise.all([
  cms.entries.findMany('products', { depth: 0, limit: 3 }).catch(() => []),
  cms.entries.findMany('posts', { depth: 1 }).then(p => p.filter(x => x.data.isPublished).slice(0, 3)).catch(() => []),
]);

function getProductName(product: any) {
  return product.data.name ?? product.data.title ?? 'Untitled product';
}

function getProductPrice(product: any) {
  return product.data.basePrice ?? product.data.price ?? 0;
}
---

<Layout title="Talisman CMS | Next-Gen Headless CMS" description="Build beautiful, fast sites with Talisman CMS and Astro.">

  <!-- Hero Section -->
  <Hero 
    heading="Build Beautiful Sites with Talisman CMS"
    subheading="The most intuitive, typesafe, and flexible headless CMS designed exclusively for Astro framework."
    pillText="v1.0 is now live!"
  >
    <Button href="/admin" variant="primary" size="lg" slot="actions">
      Open Admin Panel
    </Button>
    <Button href="https://github.com/jakob/talisman-cms" variant="outline" size="lg" slot="actions">
      View Documentation
    </Button>
  </Hero>

  <!-- Featured Products Section -->
  {products.length > 0 && (
    <section class="py-20 animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900">Featured Products</h2>
          <p class="mt-2 text-gray-500">Powered by the Official E-Commerce Plugin</p>
        </div>
        <a href="/shop" class="text-brand-600 hover:text-brand-700 font-medium hidden sm:block">View all products &rarr;</a>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <Card
            href={`/shop/${product.id}`}
            title={getProductName(product)}
          >
            <p slot="header" class="text-xs font-semibold uppercase tracking-wider text-green-600 mb-2">In Stock</p>
            <h3 slot="header" class="text-2xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2">
              {getProductName(product)}
            </h3>
            
            <p class="text-gray-600 line-clamp-2 mb-4 h-10">
              {product.data.description || 'A premium product powered by Talisman CMS.'}
            </p>
            <div class="flex items-center justify-between border-t border-gray-100 pt-4 mt-auto">
              <span class="text-2xl font-black text-gray-900">{formatMoney(getProductPrice(product), currency)}</span>
              <Button size="sm" variant="secondary" class="group-hover:bg-brand-600 group-hover:text-white transition-colors">
                View Details
              </Button>
            </div>
          </Card>
        ))}
      </div>
      <div class="mt-8 sm:hidden">
        <a href="/shop" class="text-brand-600 hover:text-brand-700 font-medium">View all products &rarr;</a>
      </div>
    </section>
  )}

  <!-- Latest Posts Section -->
  {posts.length > 0 && (
    <section class="py-20 border-t border-gray-100 animate-fade-in-up" style="animation-delay: 0.2s;">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-gray-900">From the Blog</h2>
          <p class="mt-2 text-gray-500">Latest updates, tutorials, and community news.</p>
        </div>
        <a href="/blog" class="text-brand-600 hover:text-brand-700 font-medium hidden sm:block">View all posts &rarr;</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.map(post => {
          const authorName = post.data.author?.data?.name || 'Talisman Team';
          const date = post.data.publishedAt ? new Date(post.data.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Recently';
          
          return (
            <Card href={`/blog/${post.slug}`} class="bg-gradient-to-br from-white to-gray-50">
              <p slot="header" class="text-xs font-semibold uppercase tracking-wider text-purple-600 mb-2">Tech Insights</p>
              <h3 slot="header" class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition-colors mb-3">
                {post.data.title}
              </h3>
              
              <div class="flex items-center justify-between mt-auto">
                <div class="flex items-center space-x-3">
                  <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-brand-400 to-purple-500 flex items-center justify-center text-white font-bold text-xs shadow-inner">
                    {authorName.charAt(0)}
                  </div>
                  <span class="text-sm font-medium text-gray-900">{authorName}</span>
                </div>
                <time class="text-xs text-gray-500">{date}</time>
              </div>
            </Card>
          );
        })}
      </div>
    </section>
  )}

  <!-- Dynamic Pages Preview -->
  <section class="py-20 border-t border-gray-100 animate-fade-in-up" style="animation-delay: 0.3s;">
    <div class="bg-gray-900 rounded-[2.5rem] p-10 md:p-16 text-center text-white relative overflow-hidden glass-dark border-0">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-900/40 via-transparent to-transparent opacity-50"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Create Infinite Layouts</h2>
        <p class="text-gray-300 mb-10 text-lg leading-relaxed">
          Talisman CMS supports polymorphic block references. That means you can create dynamic landing pages directly from the admin panel using predefined Astro components.
        </p>
        <div class="flex justify-center flex-wrap gap-4">
          <Button href="/about" variant="primary" class="bg-white text-gray-900 hover:bg-gray-100">
             Try the '/about' page layout
          </Button>
          <Button href="/admin" variant="outline" class="border-white/20 text-white hover:bg-white/10">
             Build a layout
          </Button>
        </div>
      </div>
    </div>
  </section>

</Layout>
