---
import Layout from '../../layouts/Layout.astro';
import { env as cfEnv } from 'cloudflare:workers';
import { formatMoney, getOrderSummary } from '../../lib/commerce';

const orderId = Astro.url.searchParams.get('order');
const orderSummary = await getOrderSummary(cfEnv as any, orderId);
---

<Layout title="Order Confirmed | Talisman CMS Showcase" description="Order confirmation for the Talisman storefront demo.">
  <section class="py-12 animate-fade-in-up">
    <div class="mx-auto max-w-3xl rounded-[2.5rem] border border-gray-200 bg-white/90 p-8 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-brand-600">Order</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-gray-900">
        {orderSummary?.order.status === 'paid' ? 'Payment confirmed' : 'Order received'}
      </h1>
      <p class="mt-3 text-gray-600">
        {orderSummary
          ? `Reference ${orderSummary.order.id}. ${orderSummary.order.status === 'pending' ? 'Payment is still pending. If you are testing Stripe locally, make sure the webhook is forwarding to /api/ecommerce/webhooks/stripe.' : 'Your order is ready for fulfillment.'}`
          : 'We could not find that order.'}
      </p>

      {orderSummary && (
        <>
          <div class="mt-8 rounded-[2rem] border border-gray-100 bg-gray-50/80 p-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Status</p>
                <p class="mt-1 text-lg font-bold capitalize text-gray-900">{orderSummary.order.status}</p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Email</p>
                <p class="mt-1 text-lg font-bold text-gray-900">{orderSummary.order.customerEmail || 'Not provided'}</p>
              </div>
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gray-400">Total</p>
                <p class="mt-1 text-lg font-bold text-gray-900">{formatMoney(orderSummary.subtotal, orderSummary.order.currency)}</p>
              </div>
            </div>
          </div>

          <div class="mt-8 space-y-4">
            {orderSummary.items.map((item) => (
              <div class="flex items-start justify-between gap-4 rounded-2xl border border-gray-100 px-5 py-4">
                <div>
                  <p class="font-semibold text-gray-900">{item.productName}</p>
                  {item.variantLabel && <p class="text-sm text-gray-500">{item.variantLabel}</p>}
                  <p class="text-xs uppercase tracking-[0.2em] text-gray-400">Qty {item.quantity}</p>
                </div>
                <span class="font-semibold text-gray-900">{formatMoney(item.lineTotal, orderSummary.order.currency)}</span>
              </div>
            ))}
          </div>
        </>
      )}

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/shop" class="inline-flex h-11 items-center justify-center rounded-full bg-brand-600 px-6 text-sm font-medium text-white transition-colors hover:bg-brand-700">
          Back to shop
        </a>
        <a href="/cart" class="inline-flex h-11 items-center justify-center rounded-full border border-gray-200 bg-white px-6 text-sm font-medium text-gray-900 transition-colors hover:border-brand-200 hover:text-brand-700">
          Open cart
        </a>
      </div>
    </div>
  </section>
</Layout>
