---
import CustomerReturns from '@talisman-cms/plugin-ecommerce/components/CustomerReturns.astro';
import OrderTracking from '@talisman-cms/plugin-ecommerce/components/OrderTracking.astro';
import {orderProgress} from '@talisman-cms/plugin-ecommerce/components/order-progress.ts';
import Layout from '../../layouts/Layout.astro';
import { orderReference, customerOrderDestination } from '@talisman-cms/plugin-ecommerce/accounts';
import { env as cfEnv } from 'cloudflare:workers';
import { formatMoney, getOrderSummary } from '../../lib/commerce';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const orderId = customerOrderDestination(Astro.url.searchParams.get('order'));
const summary = await getOrderSummary(cfEnv as any, orderId, Astro.cookies);
const order = summary?.order;
if (!order) Astro.response.status = 404;
const progress = order ? orderProgress(order.status, order.status === 'pending' && order.reconcileReviewAt !== null) : null;
const money = (amount:number) => formatMoney(amount,order?.currency ?? 'usd');
const address = order?.shippingAddress as Record<string,string> | null;

---
<Layout title={`${progress?.title ?? 'Order unavailable'} | Talisman`} description="Your order details, delivery updates and return requests.">
  <section class="store-page receipt" data-order-receipt data-order-id={order?.id} data-order-status={order?.status} data-order-review={String(order?.status === 'pending' && order.reconcileReviewAt !== null)}>
    <header class="receipt__heading"><span class="receipt__mark" data-receipt-mark data-tone={progress?.tone} aria-hidden="true">{progress?.tone === 'paid' ? '✓' : progress?.tone === 'pending' ? '◷' : '—'}</span><p class="store-eyebrow">{order ? 'Your order' : 'Order unavailable'}</p><h1 data-receipt-title>{progress?.title ?? 'This order isn’t available here.'}</h1><p data-receipt-detail>{order?.status==='refunded'&&order?.paymentProvider==='gift_card'?'Your gift card payment has been restored. Your delivery and return history remain below.':progress?.detail ?? 'Open the order link from the browser you used at checkout, or sign in to the account used for your purchase.'}</p>{order && <small>Reference <span>{orderReference(order.id)}</span></small>}</header>
    {order && summary && <>
      <nav class="receipt__account-nav" aria-label="Your account"><a href="/account" data-astro-reload class="store-text-link">← All your orders</a><span>Access your orders on any device with email sign-in.</span></nav><div class="receipt__refresh"><p data-order-update role="status">{progress?.tone==='pending'?'We’ll check for updates while you’re here.':'Refresh for the latest payment, delivery and return updates.'}</p><button type="button" class="store-text-link" data-refresh-order>Refresh order updates</button></div>
      <div class="receipt__layout">
        <section class="store-panel"><div class="receipt__section-title"><h2>Order summary</h2><span class="receipt__status" data-receipt-status>{order.status.replaceAll('_',' ')}</span></div>
          <div class="receipt__items">{summary.items.map(item => <article>{item.imageUrl && <img src={item.imageUrl} width="64" height="76" alt="" />}<div><h3>{item.productName}</h3>{item.variantLabel && <p>{item.variantLabel}</p>}<small>Qty {item.quantity}</small></div><strong>{money(item.lineTotal)}</strong></article>)}</div>
          <dl class="receipt__totals"><div><dt>Subtotal</dt><dd>{money(order.subtotalAmount)}</dd></div>{order.discountAmount>0 && <div><dt>Discount {order.discountCode}</dt><dd>−{money(order.discountAmount)}</dd></div>}<div><dt>{order.shippingLabel ?? 'Delivery'}</dt><dd>{order.shippingAmount ? money(order.shippingAmount) : 'No charge'}</dd></div>{order.taxAmount>0 && <div><dt>Tax {order.taxBehavior==='inclusive'?'(included)':''}</dt><dd>{money(order.taxAmount)}</dd></div>}<div class="receipt__total"><dt>Order total</dt><dd>{money(order.totalAmount+order.giftCardApplied+order.creditApplied)}</dd></div>{order.creditApplied>0 && <div><dt>Paid with store credit</dt><dd>{money(order.creditApplied)}</dd></div>}{order.giftCardApplied>0 && <div><dt>Paid with gift card</dt><dd>{money(order.giftCardApplied)}</dd></div>}{(order.totalAmount>0||!order.giftCardApplied)&&<div><dt>{['paid','fulfilled','partially_refunded','refunded','disputed'].includes(order.status)?'Card payment':'Amount due at payment'}</dt><dd>{money(order.totalAmount)}</dd></div>}<div data-gift-refund-row hidden={!order.giftCardRefundedCents}><dt>Refunded to gift card</dt><dd data-gift-refund>{money(order.giftCardRefundedCents)}</dd></div><div data-provider-refund-row hidden={!order.providerRefundedCents}><dt>Refunded to payment method</dt><dd data-provider-refund>{money(order.providerRefundedCents)}</dd></div><div data-credit-refund-row hidden={order.status!=='refunded'||!order.creditApplied}><dt>Store credit restored</dt><dd data-credit-refund>{money(order.creditApplied)}</dd></div></dl>
        </section>
        <aside class="receipt__aside"><section class="store-panel"><h2>Your details</h2><h3>Contact</h3><p>{order.customerEmail || 'No email provided'}</p>{address && <><h3>Delivery address</h3><address>{[address.name,address.line1,address.line2,[address.city,address.state,address.postalCode].filter(Boolean).join(', '),address.country].filter(Boolean).map(line=><span>{line}<br /></span>)}</address></>}<p class="receipt__hint">Keep this order link for delivery updates and any return or exchange requests.</p></section><div class="receipt-actions"><button class="store-button secondary" type="button" data-print-order>Print order details</button><a href="/shop" class="store-button">Explore the collection →</a></div></aside>
      </div>
      {order.paymentProvider !== 'admin_test' && ['paid','fulfilled','partially_refunded','refunded','disputed'].includes(order.status) && <div class="receipt__aftercare">{summary.items.some(item=>item.isPhysical) && <OrderTracking orderId={order.id} />}<CustomerReturns orderId={order.id} /></div>}
    </>}
    {!order && <div class="receipt-actions"><a href={orderId ? `/account?order=${encodeURIComponent(orderId)}` : "/account"} data-astro-reload class="store-button">Sign in to view your order</a><a href="/shop" class="store-button secondary">Explore the collection</a></div>}
    {order && ['cancelled','failed','draft'].includes(order.status) && <a href="/cart" class="store-button receipt-actions">Review your cart</a>}
  </section>
</Layout>
<script>import '../../lib/storefront-receipt';</script>
<style>
.receipt__account-nav{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:20px;font-size:12px;color:#646e68}.receipt__account-nav span{font-size:11px}
.receipt__refresh{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;font-size:12px;color:#646e68;flex-wrap:wrap}.receipt__refresh p{margin:0}.receipt{max-width:1100px;margin:auto}.receipt__heading{max-width:720px;margin:0 auto 40px;text-align:center}.receipt__mark{display:grid;place-items:center;width:54px;height:54px;background:#edf2e8;color:#536847;border-radius:50%;font-size:24px;margin:0 auto 20px}.receipt__mark[data-tone=pending]{background:#faf0d9;color:#806b30}.receipt__heading h1{font-size:clamp(32px,4.5vw,48px);font-weight:500;letter-spacing:-.05em;line-height:1.15;margin:14px 0}.receipt__heading>p:not(.store-eyebrow){font-size:15px;line-height:1.8;color:#646e68}.receipt__heading small{font-size:11px;color:#646e68;display:block;margin-top:20px;overflow-wrap:anywhere}.receipt__layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:28px}.receipt h2{font-size:18px;font-weight:600;letter-spacing:-.03em;margin:0}.receipt__section-title{display:flex;justify-content:space-between;gap:16px;align-items:center}.receipt__status{padding:5px 10px;background:#f2f5ed;border-radius:5px;font-size:11px;text-transform:capitalize}.receipt__items{margin:20px 0}.receipt__items article{display:flex;gap:14px;align-items:center;padding:16px 0;border-bottom:1px solid #edf0e8}.receipt__items img{width:60px;height:72px;object-fit:cover;border-radius:6px}.receipt__items article>div{flex:1}.receipt__items h3{font-size:14px;font-weight:600;margin:0}.receipt__items p,.receipt__items small{font-size:12px;color:#646e68;margin:4px 0}.receipt__items strong{font-size:14px;font-weight:500}.receipt__totals>div{display:flex;justify-content:space-between;gap:24px;font-size:13px;color:#646e68;margin:14px 0}.receipt__totals dd{color:#18201e;text-align:right}.receipt__totals .receipt__total{border-top:1px solid #dfe3dd;padding-top:20px;font-size:20px;color:#18201e}.receipt__aside h3{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:#646e68;margin:24px 0 8px}.receipt__aside p,.receipt__aside address{font-size:14px;line-height:1.8;font-style:normal;overflow-wrap:anywhere}.receipt__aside .receipt__hint{border-top:1px solid #dfe3dd;padding-top:20px;margin-top:24px;color:#646e68;font-size:12px}.receipt-actions{display:flex;flex-direction:column;gap:10px;margin-top:20px}.receipt__aftercare{margin-top:32px;border-top:1px solid #dfe3dd;padding-top:8px}.receipt__aftercare :global(>section){max-width:none;background:white;border:1px solid #dfe3dd;border-radius:16px;padding:28px}.receipt__aftercare :global(h2){font-size:20px;font-weight:600;letter-spacing:-.03em}.receipt__aftercare :global(p){font-size:13px;line-height:1.8;color:#646e68}.receipt__aftercare :global(button){font-size:13px}.receipt__aftercare :global(input),.receipt__aftercare :global(select),.receipt__aftercare :global(textarea){background:white;border:1px solid #cfd6cc;color:#18201e;border-radius:6px}.receipt__aftercare :global(article){border-color:#dfe3dd}
@media(max-width:700px){.receipt__layout{grid-template-columns:1fr;gap:20px}.receipt__heading{margin-bottom:28px}.receipt__aftercare :global(>section){padding:20px}}
</style>
