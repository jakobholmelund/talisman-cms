---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import Hero from '../../components/Hero.astro';
import { getClient } from 'talisman-cms/client';
import { env as cfEnv } from 'cloudflare:workers';
import { getPrimaryProductImage } from '../../lib/product-media';

const env = { DB: (cfEnv as any).DB, KV: (cfEnv as any).KV };
const cms = getClient(env);
const products = await cms.entries.findMany('products', { depth: 0, cache: false }).catch(() => []);

function getProductName(product: any) {
  return product.data.name ?? product.data.title ?? 'Untitled product';
}

function getProductPrice(product: any) {
  return product.data.basePrice ?? product.data.price ?? 0;
}

function getInventory(product: any) {
  return product.data.inventoryQuantity ?? 0;
}
---

<Layout title="Shop | Talisman CMS E-commerce Showcase">
  <Hero 
    heading="The Shop" 
    subheading="Browse our selection of premium items powered by the Talisman CMS Native E-Commerce Plugin." 
  />

  <div class="py-12">
    <div class="mb-8 flex justify-between items-center border-b border-gray-100 pb-4">
      <h2 class="text-2xl font-bold text-gray-900">All Products ({products.length})</h2>
      <div class="flex gap-4 text-sm text-text-muted">
        <span class="font-medium text-brand-600 cursor-pointer">All</span>
        <span class="cursor-pointer hover:text-gray-900 transition-colors">Physical</span>
        <span class="cursor-pointer hover:text-gray-900 transition-colors">Digital</span>
      </div>
    </div>

    {products.length === 0 ? (
      <div class="text-center py-24 bg-gray-50 rounded-2xl border border-gray-100 border-dashed">
        <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <h3 class="text-sm font-semibold text-gray-900">No products</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by adding some products in the Admin side.</p>
        <div class="mt-6">
          <a href="/admin/collections/products" target="_blank" class="inline-flex items-center rounded-md bg-brand-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600">
            Add Product
          </a>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {products.map((product) => (
          <Card
            href={`/shop/${product.id}`}
            title={getProductName(product)}
            image={getPrimaryProductImage(product.data) ?? undefined}
            imageTransitionName={`product-image-${product.id}`}
          >
            <p slot="header" class={`text-xs font-semibold uppercase tracking-wider mb-2 ${getInventory(product) > 0 || product.data.type === 'digital' ? 'text-green-600' : 'text-amber-600'}`}>
              {getInventory(product) > 0 || product.data.type === 'digital' ? 'In Stock' : 'Low Stock'}
            </p>
            <h3 slot="header" class="text-xl font-bold text-gray-900 group-hover:text-brand-600 transition-colors mb-2 line-clamp-1">
              {getProductName(product)}
            </h3>
            
            <p class="text-gray-600 line-clamp-2 h-10 mb-4 text-sm">
              {product.data.description || 'A premium product powered by Talisman CMS.'}
            </p>
            <div class="flex flex-col mt-auto pt-4 border-t border-gray-100">
              <span class="text-2xl font-black text-gray-900">${(getProductPrice(product) / 100).toFixed(2)}</span>
            </div>
          </Card>
        ))}
      </div>
    )}
  </div>
</Layout>
