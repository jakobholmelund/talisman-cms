---
import Layout from '../../layouts/Layout.astro';
import CatalogBrowser from '@talisman-cms/plugin-ecommerce/components/CatalogBrowser.astro';
import { searchCatalog, type CatalogSearchOptions } from '@talisman-cms/plugin-ecommerce/catalog';
import { env as cfEnv } from 'cloudflare:workers';
import { getStoreCurrency } from '../../lib/commerce';

const params = Astro.url.searchParams;
const sort = params.get('sort') ?? 'newest';
const type = params.get('type') ?? '';
const requestedPage = Number(params.get('page'));
const options: CatalogSearchOptions = {
  query: (params.get('q') ?? '').slice(0, 120), category: (params.get('category') ?? '').slice(0, 128),
  type: ['standard', 'digital', 'subscription'].includes(type) ? type as CatalogSearchOptions['type'] : '',
  sort: ['newest', 'price-asc', 'price-desc', 'name'].includes(sort) ? sort as CatalogSearchOptions['sort'] : 'newest',
  inStock: params.get('stock') === 'available', page: Number.isSafeInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1,
};
let catalog: Awaited<ReturnType<typeof searchCatalog>> | null = null;
try { catalog = await searchCatalog(cfEnv as any, options); } catch { Astro.response.status = 503; }
const currency = getStoreCurrency(cfEnv as any);
---

<Layout title="The collection | Talisman" description="Explore the Talisman collection. Find your favorite, choose your options, and make it yours.">
  <header class="shop-heading"><div><p>Considered goods. Everyday possibilities.</p><h1>Find your next<br /><em>favorite.</em></h1></div><span>Explore the collection at your own pace.<br />The right details make all the difference.</span></header>
  {catalog ? <CatalogBrowser catalog={catalog} currency={currency} /> : <section class="shop-unavailable" role="alert"><h2>The collection is taking a moment.</h2><p>We couldn’t load the products. Please try again.</p><a href={Astro.url.pathname + Astro.url.search}>Try again</a></section>}
</Layout>

<style>
  .shop-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px; padding: 40px 0 48px; border-bottom: 1px solid #dfe3dd; color: #18201e; }
  .shop-heading p { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: #646e68; margin: 0 0 20px; }
  .shop-heading h1 { font-size: clamp(48px, 7vw, 84px); font-weight: 500; letter-spacing: -.065em; line-height: 1.05; margin: 0; }
  .shop-heading em { font-family: Georgia, serif; font-weight: 400; color: #536847; }
  .shop-heading > span { color: #646e68; font-size: 13px; line-height: 1.9; padding-bottom: 6px; }
  .shop-unavailable { text-align: center; padding: 80px 24px; color: #18201e; }
  .shop-unavailable h2 { font-size: 28px; margin-bottom: 16px; }
  .shop-unavailable a { display: inline-block; margin-top: 24px; text-decoration: underline; }
  @media (max-width: 700px) { .shop-heading { padding: 20px 0 28px; gap: 20px; } .shop-heading p { margin-bottom: 14px; } .shop-heading > span { display: none; } }
</style>
