---
import Layout from '../../layouts/Layout.astro';
import DaisyUiThemeInjector from '@talisman-cms/plugin-ui-daisyui/components/DaisyUiThemeInjector.astro';
import DaisyUiPreviewContent from '@talisman-cms/plugin-ui-daisyui/components/DaisyUiPreviewContent.astro';
---
<Layout title="Custom DaisyUI Preview">
  <!-- Inject the global theme variables so the preview utilizes the selected CMS colors -->
  <DaisyUiThemeInjector slot="head" />
  
  <main class="py-12 w-full max-w-7xl mx-auto px-4">
    <div class="mb-8 border-b pb-4">
      <h1 class="text-3xl font-bold">Host Project Layout Wrapper</h1>
      <p class="text-gray-500">This page demonstrates importing the DaisyUI Preview directly into the host project's ASTRO Layout.</p>
    </div>

    <!-- The exact same preview content generated by the plugin, but now inside your own wrapper -->
    <DaisyUiPreviewContent />
  </main>
</Layout>
