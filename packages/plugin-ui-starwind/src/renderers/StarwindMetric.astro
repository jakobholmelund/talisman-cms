---
import { safeText } from './sanitize';
const value = safeText(Astro.props.value);
const label = safeText(Astro.props.label);
const summary = safeText(Astro.props.summary);
---

<div class="min-w-0 wrap-anywhere rounded-3xl border border-white/10 bg-slate-900 p-5 text-white shadow-lg">
  <div class="text-3xl font-semibold tracking-tight">{value}</div>
  <div class="mt-2 text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">{label}</div>
  {summary ? <p class="mt-3 text-sm text-slate-300">{summary}</p> : null}
</div>
