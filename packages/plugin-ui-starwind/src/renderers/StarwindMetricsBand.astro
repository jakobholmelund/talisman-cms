---
import ComponentSlotRenderer from 'talisman-cms/render/ComponentSlotRenderer.astro';

const { title, description, items, componentRenderers, presetsById } = Astro.props;
---

<section class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-xl">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-semibold tracking-tight text-slate-950">{title}</h2>
    {description ? <p class="mt-3 text-slate-600">{description}</p> : null}
  </div>
  <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    <ComponentSlotRenderer value={items} componentRenderers={componentRenderers} presetsById={presetsById} />
  </div>
</section>
