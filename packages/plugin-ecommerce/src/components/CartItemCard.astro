---
import { formatMoney } from '@talisman-cms/plugin-ecommerce/money';
import type { CartItem } from './cart-types';
interface Props { item: CartItem; locked?: boolean; currency?: string; }
const { item, locked = false, currency = 'usd' } = Astro.props;
---
<article class="shopping-cart__item" data-cart-item data-product-id={item.productId} data-variant-id={item.variantId || ''}>
  <a data-cart-image-link href={item.href} class="shopping-cart__image" tabindex="-1" aria-hidden="true">
    <img data-cart-image src={item.imageUrl || undefined} alt="" width="112" height="132" hidden={!item.imageUrl} />
    <span data-cart-image-fallback hidden={Boolean(item.imageUrl)}>◇</span>
  </a>
  <div class="shopping-cart__item-body">
    <div class="shopping-cart__item-heading"><div><a data-cart-name href={item.href}>{item.productName}</a><p data-cart-variant hidden={!item.variantLabel}>{item.variantLabel}</p></div><strong data-cart-line-total>{formatMoney(item.lineTotal, currency)}</strong></div>
    <p data-cart-stock class="shopping-cart__stock" data-unavailable={item.unavailable}>{item.stockLabel}</p>
    <div class="shopping-cart__item-actions">
      <div class="shopping-cart__quantity" role="group" aria-label={`Quantity of ${item.productName}`}>
        <button type="button" data-cart-action="decrement" data-product-id={item.productId} data-variant-id={item.variantId || ''} aria-label={`Decrease quantity of ${item.productName}`} disabled={locked || item.quantity <= 1}>−</button>
        <input data-cart-quantity type="number" inputmode="numeric" min="1" max="99" step="1" value={item.quantity} aria-label={`Quantity of ${item.productName}`} disabled={locked} />
        <button type="button" data-cart-action="increment" data-product-id={item.productId} data-variant-id={item.variantId || ''} aria-label={`Increase quantity of ${item.productName}`} disabled={locked}>+</button>
      </div>
      <span data-cart-unit-price>{formatMoney(item.unitPrice, currency)} each</span>
      <button type="button" data-cart-action="remove" data-product-id={item.productId} data-variant-id={item.variantId || ''} aria-label={`Remove ${item.productName} from cart`} disabled={locked}>Remove</button>
    </div>
  </div>
</article>
