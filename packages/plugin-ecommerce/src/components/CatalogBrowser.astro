---
import { catalogOffer, type searchCatalog } from '@talisman-cms/plugin-ecommerce/catalog';
import { formatMoney } from '@talisman-cms/plugin-ecommerce/money';
import { getMediaImageSrcSet } from 'talisman-cms/helpers';
interface Props { catalog: Awaited<ReturnType<typeof searchCatalog>>; currency: string; basePath?: string; }
const { catalog, currency, basePath = '/shop' } = Astro.props;
const { filters, products, total, page, pages, pageSize, categories } = catalog;
function url(change: Record<string, string | null>) {
  const params = new URLSearchParams();
  if (filters.query) params.set('q', filters.query);
  if (filters.category) params.set('category', filters.category);
  if (filters.type) params.set('type', filters.type);
  if (filters.inStock) params.set('stock', 'available');
  if (filters.sort !== 'newest') params.set('sort', filters.sort);
  for (const [key, value] of Object.entries(change)) value ? params.set(key, value) : params.delete(key);
  return `${basePath}${params.size ? `?${params}` : ''}`;
}
const chips = [
  ...(filters.query ? [{ key: 'q', label: `“${filters.query}”` }] : []),
  ...(filters.category ? [{ key: 'category', label: categories.find(row => row.id === filters.category)?.name ?? 'Selected category' }] : []),
  ...(filters.type ? [{ key: 'type', label: { standard: 'Standard products', digital: 'Digital products', subscription: 'Subscriptions' }[filters.type] }] : []),
  ...(filters.inStock ? [{ key: 'stock', label: 'In stock' }] : []),
];
---
<section class="catalog" aria-label="Product catalog">
  <form id="catalog-filters" action={basePath} method="get" class="catalog__toolbar" role="search" aria-label="Search products">
    <div class="catalog__search"><label for="catalog-query" class="catalog__sr">Search products</label><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="catalog-query" type="search" name="q" value={filters.query} maxlength="120" placeholder="Find something you’ll love" /><button type="submit">Search</button></div>
    <label class="catalog__sort"><span>Sort by</span><select name="sort"><option value="newest" selected={filters.sort === 'newest'}>Newest arrivals</option><option value="price-asc" selected={filters.sort === 'price-asc'}>Price: low to high</option><option value="price-desc" selected={filters.sort === 'price-desc'}>Price: high to low</option><option value="name" selected={filters.sort === 'name'}>Name: A–Z</option></select></label>
  </form>
  {categories.length > 0 && <nav class="catalog__categories" aria-label="Shop by category"><a href={url({category:null})} aria-current={!filters.category ? 'true' : undefined}>All goods</a>{categories.map(category=><a href={url({category:category.id})} aria-current={filters.category===category.id ? 'true' : undefined}>{category.name}<span>{category.count}</span></a>)}</nav>}
  <div class="catalog__layout">
    <aside aria-label="Product filters"><details class="catalog__filter-disclosure" open><summary>Refine your search {chips.length > 0 && `(${chips.length})`} <span aria-hidden="true">+</span></summary><div class="catalog__filters">
      {chips.length > 0 && <a class="catalog__filter-reset" href={basePath}>Reset filters</a>}
      {categories.length > 0 && <label>Category<select name="category" form="catalog-filters"><option value="">All categories</option>{categories.map(category => <option value={category.id} selected={category.id === filters.category}>{category.name} ({category.count})</option>)}</select></label>}
      <label>Product type<select name="type" form="catalog-filters"><option value="">All products</option><option value="standard" selected={filters.type === 'standard'}>Standard products</option><option value="digital" selected={filters.type === 'digital'}>Digital products</option><option value="subscription" selected={filters.type === 'subscription'}>Subscriptions</option></select></label>
      <label class="catalog__check"><input type="checkbox" name="stock" value="available" checked={filters.inStock} form="catalog-filters" /> In stock only</label>
      <button class="catalog__apply" type="submit" form="catalog-filters">Apply filters</button>
      <p class="catalog__filter-note">Find your favorite. Choose the details that make it yours.</p>
    </div></details></aside>
    <div class="catalog__results">
      <div class="catalog__results-heading"><h2>{filters.query ? 'Search results' : 'The collection'}</h2><span role="status">{total} {total === 1 ? 'product' : 'products'}{pages > 1 && ` · Page ${page} of ${pages}`}</span></div>
      {chips.length > 0 && <nav class="catalog__chips" aria-label="Applied filters">{chips.map(chip => <a href={url({ [chip.key]: null })} aria-label={`Remove filter: ${chip.label}`}>{chip.label}<span aria-hidden="true">×</span></a>)}<a class="catalog__clear" href={basePath}>Clear all</a></nav>}
      {products.length === 0 ? <div class="catalog__empty"><span aria-hidden="true">↗</span><h3>{chips.length ? 'A little less specific?' : 'Good things are on the way.'}</h3><p>{chips.length ? 'Try a different search or remove a filter to explore more of the collection.' : 'Our collection will appear here when products become available.'}</p>{chips.length > 0 && <a href={basePath}>Explore all products</a>}</div> : <div class="catalog__grid">{products.map(product => {
        const offer = catalogOffer(product);
        const imageValue = (product.images as unknown[] | null)?.find(image => typeof image === 'string' || image && typeof image === 'object' && 'url' in image);
        const image = typeof imageValue === 'string' ? imageValue : (imageValue as { url?: string } | undefined)?.url;
        return <a class="catalog__product" href={`${basePath}/${encodeURIComponent(product.id)}`}>
          <div class="catalog__image">{image ? <img src={image} srcset={getMediaImageSrcSet(image)} sizes="(min-width: 1024px) 300px, (min-width: 640px) 45vw, 90vw" alt={product.name} width="600" height="700" loading="lazy" decoding="async" /> : <span class="catalog__placeholder" aria-hidden="true">◇</span>}<span class="catalog__availability" data-available={offer.available}>{offer.available ? product.type === 'digital' ? 'Digital' : 'In stock' : 'Unavailable'}</span><span class="catalog__view" aria-hidden="true">Explore product ↗</span></div>
          <div class="catalog__product-info"><p class="catalog__category">{product.categories[0]?.name ?? (product.type === 'digital' ? 'Digital collection' : 'The essentials')}</p><div class="catalog__product-heading"><h3>{product.name}</h3><p>{offer.minPrice !== offer.maxPrice && <small>From </small>}{offer.minPrice > 0 ? formatMoney(offer.minPrice, currency) : 'Price unavailable'}</p></div>{product.description && <p class="catalog__description">{product.description}</p>}<span class="catalog__options">{offer.options.length ? `${offer.options.length} ${offer.options.length === 1 ? 'option' : 'options'} to explore` : 'Discover the details'} <span aria-hidden="true">→</span></span></div>
        </a>;
      })}</div>}
      {pages > 1 && <nav class="catalog__pagination" aria-label="Catalog pages">{page > 1 ? <a rel="prev" href={url({ page: String(page - 1) })}>← Previous</a> : <span />}<span>{(page - 1) * pageSize + 1}–{Math.min(page * pageSize, total)} of {total}</span>{page < pages ? <a rel="next" href={url({ page: String(page + 1) })}>Next →</a> : <span />}</nav>}
    </div>
  </div>
</section>
<script>
  function setupFilters() {
    const form=document.querySelector<HTMLFormElement>('#catalog-filters');
    if(form && !form.dataset.bound){form.dataset.bound='true';form.querySelector('select[name=sort]')?.addEventListener('change',()=>form.requestSubmit());}
    document.querySelectorAll<HTMLDetailsElement>('.catalog__filter-disclosure').forEach(details => {
      if (details.dataset.bound) return;
      details.dataset.bound = 'true';
      const smallScreen = window.matchMedia('(max-width: 700px)');
      const adapt = () => { details.open = !smallScreen.matches; };
      adapt();
      smallScreen.addEventListener('change', adapt);
      document.addEventListener('astro:before-swap', () => smallScreen.removeEventListener('change', adapt), { once: true });
    });
  }
  document.addEventListener('astro:page-load', setupFilters);
  setupFilters();
</script>
<style>
  .catalog { --ink: #18201e; --muted: #646e68; --line: #dfe3dd; color: var(--ink); padding: 32px 0; }
  .catalog *, .catalog *::before, .catalog *::after { box-sizing: border-box; }
  .catalog a { color: inherit; text-decoration: none; }
  .catalog :is(button, input, select, a, summary):focus-visible { outline: 2px solid #4f46e5; outline-offset: 4px; }
  .catalog__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .catalog__toolbar { display: flex; gap: 32px; align-items: center; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .catalog__search { display: flex; gap: 12px; align-items: center; flex: 1; min-width: 0; border: 1px solid var(--line); border-radius: 12px; background: #fff; padding: 7px 8px 7px 16px; }
  .catalog__search input { flex: 1; width: 100%; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 14px; min-height: 36px; }
  .catalog button { font: inherit; cursor: pointer; }
  .catalog__search button, .catalog__apply { border: 0; background: var(--ink); color: #fff; border-radius: 8px; padding: 12px 18px; font-size: 13px !important; font-weight: 600 !important; }
  .catalog__sort { display: flex; align-items: center; gap: 12px; font-size: 13px; }
  .catalog__sort span { color: var(--muted); white-space: nowrap; }
  .catalog select { font: inherit; border: 1px solid var(--line); color: var(--ink); border-radius: 8px; background: #fff; min-height: 44px; padding: 10px; max-width: 100%; }
  .catalog__categories {display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.catalog__categories a{display:flex;gap:10px;align-items:center;font-size:12px;padding:10px 15px;border:1px solid var(--line);border-radius:24px;background:white}.catalog__categories a[aria-current]{background:#18201e;color:white;border-color:#18201e}.catalog__categories span{font-size:10px;opacity:.65}
  .catalog__layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 40px; padding-top: 32px; }
  .catalog__filters { align-self: start; }
  .catalog__filter-disclosure summary { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 14px; font-weight: 650; cursor: pointer; list-style: none; padding: 0 0 24px; }
  .catalog__filter-disclosure summary::-webkit-details-marker { display: none; }
  .catalog__filter-disclosure summary span { font-size: 20px; font-weight: 400; }
  .catalog__filter-disclosure[open] summary span { transform: rotate(45deg); }
  .catalog__filter-reset { display: block; margin-bottom: 16px; font-size: 12px; text-decoration: underline !important; }
  .catalog__filters > label { display: grid; gap: 10px; font-size: 13px; margin-bottom: 24px; }
  .catalog__filters .catalog__check { display: flex; align-items: center; gap: 10px; min-height: 30px; }
  .catalog__check input { width: 17px; height: 17px; accent-color: #3730a3; }
  .catalog__apply { width: 100%; }
  .catalog__filter-note { margin: 28px 0; padding-top: 24px; border-top: 1px solid var(--line); font-size: 12px; line-height: 1.8; color: var(--muted); }
  .catalog__results-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 24px; }
  .catalog__results-heading h2 { font-size: 22px; font-weight: 600; letter-spacing: -.04em; margin: 0; }
  .catalog__results-heading > span { color: var(--muted); font-size: 12px; }
  .catalog__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .catalog__chips a { display: flex; gap: 14px; align-items: center; border: 1px solid var(--line); border-radius: 30px; padding: 8px 12px; font-size: 12px; background: #fff; overflow-wrap: anywhere; }
  .catalog__chips .catalog__clear { border-color: transparent; background: transparent; text-decoration: underline; }
  .catalog__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 22px; }
  .catalog__product { min-width: 0; display: block; }
  .catalog__image { position: relative; aspect-ratio: 4 / 5; border-radius: 12px; background: #eeefea; overflow: hidden; display: grid; place-items: center; }
  .catalog__image img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .catalog__product:hover img { transform: scale(1.035); }
  .catalog__placeholder { font-size: 80px; color: #a7b0a2; }
  .catalog__availability { position: absolute; top: 12px; left: 12px; font-size: 10px; letter-spacing: .04em; font-weight: 600; padding: 6px 9px; border-radius: 5px; color: #605544; background: #faf6ee; }
  .catalog__availability[data-available="true"] { background: #f5f8ef; color: #354b32; }
  .catalog__view { position: absolute; bottom: 12px; left: 12px; right: 12px; padding: 12px; border-radius: 6px; background: #fffffff0; font-size: 12px; text-align: center; opacity: 0; transform: translateY(6px); transition: opacity .2s, transform .2s; }
  .catalog__product:is(:hover, :focus-visible) .catalog__view { opacity: 1; transform: translateY(0); }
  .catalog__product-info { padding: 16px 0 0; }
  .catalog__category { font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin: 0 0 8px; }
  .catalog__product-heading { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; justify-content: space-between; }
  .catalog__product-heading h3 { font-size: 16px; font-weight: 600; margin: 0; line-height: 1.5; }
  .catalog__product-heading p { font-size: 14px; font-weight: 600; margin: 0; font-variant-numeric: tabular-nums; }
  .catalog__product-heading small { color: var(--muted); font-size: 11px; font-weight: 400; }
  .catalog__description { font-size: 12px; line-height: 1.7; color: var(--muted); margin: 8px 0; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  .catalog__options { display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 12px; margin-top: 14px; font-size: 11px; color: var(--muted); }
  .catalog__empty { padding: 60px 20px; border: 1px dashed var(--line); border-radius: 16px; text-align: center; }
  .catalog__empty > span { font-size: 36px; color: var(--muted); }
  .catalog__empty h3 { font-size: 24px; margin: 14px 0; }
  .catalog__empty p { color: var(--muted); font-size: 14px; max-width: 360px; margin: 0 auto 24px; line-height: 1.7; }
  .catalog__empty a { text-decoration: underline; text-underline-offset: 5px; }
  .catalog__pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; padding-top: 32px; margin-top: 32px; border-top: 1px solid var(--line); font-size: 13px; }
  .catalog__pagination a { padding: 10px 0; }
  .catalog__pagination > :last-child { text-align: right; }
  .catalog__pagination > span { color: var(--muted); }
  @media (max-width: 1100px) { .catalog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .catalog__layout { gap: 24px; grid-template-columns: 180px minmax(0, 1fr); } }
  @media (max-width: 700px) { .catalog__toolbar { flex-direction: column; align-items: stretch; gap: 14px; } .catalog__sort { justify-content: space-between; } .catalog__layout { grid-template-columns: 1fr; } .catalog__filters { display: flex; flex-wrap: wrap; align-items: end; gap: 12px; padding-bottom: 20px; } .catalog__filter-disclosure { border-bottom: 1px solid var(--line); } .catalog__filter-disclosure summary { padding-bottom: 16px; } .catalog__filter-reset { flex-basis: 100%; margin: 0; } .catalog__filters > label { flex: 1 1 130px; margin: 0; } .catalog__apply { width: auto; } .catalog__filter-note { display: none; } .catalog__grid { gap: 28px 14px; } .catalog__product-heading { display: block; } .catalog__product-heading p { margin-top: 6px; } }
  @media (max-width: 380px) { .catalog__grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .catalog__image img, .catalog__view { transition: none; } }
</style>
