---
interface Props { orderId:string; }
const {orderId}=Astro.props;
---
<section class="talisman-customer-returns" data-customer-returns data-order-id={orderId} aria-label="Return requests">
  <h2>Return requests</h2>
  <p>Need a different fit, or something not quite right? Request a return or exchange for received items here.</p><ol class="returns-steps" aria-label="How returns work"><li><strong>1. Make your request</strong><span>Choose items, quantities and a reason.</span></li><li><strong>2. Wait for approval</strong><span>Follow the store’s instructions before sending anything.</span></li><li><strong>3. Follow the progress</strong><span>Track inspection, refunds or your replacement here.</span></li></ol>
  <p data-return-status role="status" aria-live="polite">Loading return requests…</p>
  <div data-return-history></div>
  <div data-refund-history aria-label="Return refunds"></div>
  <form data-return-form aria-label="Request a return" hidden>
    <div data-return-lines></div>
    <label>Requested outcome<select aria-label="Requested outcome" data-return-intent><option value="return">Return</option><option value="exchange">Exchange</option></select></label>
    <section data-exchange-picker hidden aria-label="Preferred replacement">
      <p>Choose a quantity for one original item, then find a preferred replacement. Catalog prices are indicative. Staff approval, inspection, available stock and any agreed payment or refund are required before dispatch.</p>
      <label>Replacement search<input aria-label="Replacement search" data-exchange-search maxlength="100"/></label>
      <button type="button" data-exchange-find>Find replacement options</button>
      <div data-exchange-options></div><p data-exchange-choice aria-live="polite"></p>
      <button type="button" data-exchange-previous>Previous replacement options</button>
      <button type="button" data-exchange-next>Next replacement options</button>
    </section>
    <label>Return category<select aria-label="Return category" name="reasonCode"><option value="other">Other reason</option><option value="size_fit">Size or fit</option><option value="damaged">Damaged item</option><option value="wrong_item">Wrong item</option><option value="changed_mind">Changed my mind</option></select></label>
    <label>Reason for your return<textarea name="reason" minlength="8" maxlength="1000" required></textarea></label>
    <button type="submit">Submit return request</button>
    <button type="button" data-discard-return>Discard request draft</button>
  </form>
  <button type="button" data-recover-return hidden>Recover same request</button>
  <button type="button" data-refresh-returns>Refresh return requests</button>
</section>
<script>
  import {mountCustomerReturns} from './customer-returns-view';
  function setupReturns(){for(const root of document.querySelectorAll<HTMLElement>('[data-customer-returns]')) mountCustomerReturns(root);}
  document.addEventListener('astro:page-load',setupReturns);setupReturns();
</script>
<style is:global>
  .returns-steps{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;padding:18px 0;margin:16px 0;border-block:1px solid #dfe3dd}.returns-steps strong{display:block;font-size:13px;margin-bottom:7px}.returns-steps span{display:block;font-size:12px;color:#646e68;line-height:1.7}@media(max-width:600px){.returns-steps{grid-template-columns:1fr;gap:14px}}
  .talisman-customer-returns{margin:2rem 0;max-width:48rem;overflow-wrap:anywhere}
  .talisman-customer-returns h2{font-size:1.5rem;margin:1rem 0}
  .talisman-customer-returns article{border-top:1px solid #aaa5;padding:1rem 0}
  .talisman-customer-returns h3,.talisman-customer-returns h4{font-size:1.05rem;font-weight:600;margin:.75rem 0}
  .talisman-customer-returns [data-exchange-progress]{margin:1rem 0;padding:.75rem;border:1px solid #aaa5;border-radius:.5rem}
  .talisman-customer-returns [data-exchange-progress] ul{list-style:none;padding:0;margin:0}
  .talisman-customer-returns [data-exchange-progress] li{margin:.75rem 0}
  .talisman-customer-returns label{display:flex;flex-direction:column;gap:.5rem;margin:1rem 0}
  .talisman-customer-returns input,.talisman-customer-returns textarea{font:inherit;padding:.5rem;border:1px solid #aaa;border-radius:.3rem;color:inherit;background:transparent;min-width:0;max-width:100%}
  .talisman-customer-returns input{width:6rem}.talisman-customer-returns select{font:inherit;padding:.5rem;border:1px solid #aaa;border-radius:.3rem;color:inherit;background:transparent;max-width:100%}.talisman-customer-returns textarea{width:100%;min-height:6rem}
  .talisman-customer-returns [data-exchange-search]{width:100%}
  .talisman-customer-returns button{font:inherit;padding:.6rem .8rem;border:1px solid currentColor;border-radius:.5rem;margin:.25rem .25rem .25rem 0;background:transparent;cursor:pointer}
  .talisman-customer-returns button:disabled{opacity:.6;cursor:wait}
</style>
