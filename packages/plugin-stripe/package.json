{
  "name": "@talisman-cms/plugin-stripe",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Stripe plugin for Talisman CMS",
  "keywords": [
    "talisman-cms",
    "talisman-cms-plugin",
    "astro",
    "cloudflare",
    "cms",
    "stripe",
    "payments"
  ],
  "homepage": "https://github.com/jakobholmelund/talisman-cms/tree/main/packages/plugin-stripe#readme",
  "bugs": {
    "url": "https://github.com/jakobholmelund/talisman-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakobholmelund/talisman-cms.git",
    "directory": "packages/plugin-stripe"
  },
  "author": "Jakob Holmelund",
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./runtime-hooks": {
      "types": "./dist/runtime-hooks.d.ts",
      "import": "./dist/runtime-hooks.js"
    },
    "./routes/*": {
      "types": "./dist/routes/*.d.ts",
      "import": "./dist/routes/*.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "drizzle",
    "!drizzle/**/snapshot.json"
  ],
  "scripts": {
    "build": "tsup src/schema.ts src/index.ts src/proxy.ts src/runtime-hooks.ts src/routes/sync.ts src/routes/rest.ts src/routes/webhooks.ts --format esm --dts --clean --external cloudflare:workers --external virtual:talisman-cms/stripe-config --external virtual:talisman-cms/native-schemas",
    "test": "pnpm run build && node --experimental-sqlite --test ./test/*.test.mjs",
    "dev": "tsup src/schema.ts src/index.ts src/proxy.ts src/runtime-hooks.ts src/routes/sync.ts src/routes/rest.ts src/routes/webhooks.ts --format esm --dts --watch --external cloudflare:workers --external virtual:talisman-cms/stripe-config --external virtual:talisman-cms/native-schemas",
    "prepack": "pnpm run build",
    "prepublishOnly": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Publish with pnpm (pnpm release:publish) so workspace: ranges are rewritten and LICENSE.md is packed.'); process.exit(1); }\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "stripe": "^22.6.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "talisman-cms": "workspace:^",
    "drizzle-orm": "^1.0.0-rc.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^26.6.2",
    "astro": "^7.4.12",
    "talisman-cms": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "drizzle-orm": "rc"
  }
}
