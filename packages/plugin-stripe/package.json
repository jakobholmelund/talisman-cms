{
  "name": "@talisman-cms/plugin-stripe",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "description": "Stripe plugin for Talisman CMS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./runtime-hooks": {
      "types": "./dist/runtime-hooks.d.ts",
      "import": "./dist/runtime-hooks.js"
    },
    "./routes/*": "./src/routes/*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/routes"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/proxy.ts src/runtime-hooks.ts src/routes/rest.ts src/routes/webhooks.ts --format esm,cjs --dts --external cloudflare:workers --external virtual:talisman-cms/stripe-config",
    "test": "pnpm run build && node --test ./test/*.test.mjs",
    "dev": "tsup src/index.ts src/proxy.ts src/runtime-hooks.ts src/routes/rest.ts src/routes/webhooks.ts --format esm,cjs --dts --watch --external cloudflare:workers --external virtual:talisman-cms/stripe-config"
  },
  "dependencies": {
    "talisman-cms": "workspace:*",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^26.6.2",
    "astro": "^7.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
