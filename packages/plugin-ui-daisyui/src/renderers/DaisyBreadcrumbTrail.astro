---
import { safeHref } from './sanitize';

const { items = [] } = Astro.props;
---

<div class="text-sm breadcrumbs">
  <ul>
    {items.map((item: any) => {
      const href = safeHref(item?.href, '');
      return (
        <li>
          {href ? <a href={href}>{item?.label}</a> : <span>{item?.label}</span>}
        </li>
      );
    })}
  </ul>
</div>
