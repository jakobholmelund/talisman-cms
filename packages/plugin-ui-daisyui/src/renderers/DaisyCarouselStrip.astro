---
const { items = [] } = Astro.props;
---

<div class="carousel w-full rounded-box">
  {items.map((item: any, index: number) => (
    <div id={`carousel-item-${index}`} class="carousel-item relative w-full">
      <div class="grid min-h-64 w-full place-content-center bg-base-200 p-8 text-center">
        <div>
          {item?.title ? <h3 class="text-xl font-semibold">{item.title}</h3> : null}
          {item?.description ? <p class="mt-2 text-sm text-base-content/70">{item.description}</p> : null}
        </div>
      </div>
    </div>
  ))}
</div>
