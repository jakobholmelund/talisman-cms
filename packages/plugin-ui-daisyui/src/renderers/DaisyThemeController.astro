---
import { sanitizeThemeSettings } from '../components/theme-css';
const { theme = 'light', label = 'Preview theme' } = Astro.props;
const safeTheme = sanitizeThemeSettings({ lightTheme: theme }).settings.lightTheme || 'light';
---

<div class="form-control" data-theme={safeTheme}>
  <p class="label">{label}: {safeTheme}</p>
  <slot />
</div>
