---
import { safeHref } from './sanitize';

const { items = [] } = Astro.props;
---

<nav class="join" aria-label="Pagination">
  {items.map((item: any) => {
    const href = safeHref(item?.href, '');
    const buttonClass = ['join-item', 'btn', item?.active ? 'btn-active' : '', item?.disabled ? 'btn-disabled' : '']
      .filter(Boolean)
      .join(' ');

    return href && !item?.disabled ? (
      <a href={href} class={buttonClass} aria-current={item?.active ? 'page' : undefined}>
        {item?.label}
      </a>
    ) : (
      <span class={buttonClass} aria-current={item?.active ? 'page' : undefined}>
        {item?.label}
      </span>
    );
  })}
</nav>
