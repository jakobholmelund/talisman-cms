---
import { safeHref } from './sanitize';

const { imageUrl, alt = 'Masked image', shape = 'squircle' } = Astro.props;
const shapeClass = ({
  squircle: 'mask-squircle',
  heart: 'mask-heart',
  hexagon: 'mask-hexagon',
  circle: 'rounded-full',
} as Record<string, string>)[shape as string] || 'mask-squircle';
const isCircle = shape === 'circle';
const imageSrc = safeHref(imageUrl, '');
---

{imageSrc ? (
  <img src={imageSrc} alt={alt} class={`${isCircle ? '' : 'mask'} ${shapeClass} h-40 w-40 object-cover`} />
) : null}
