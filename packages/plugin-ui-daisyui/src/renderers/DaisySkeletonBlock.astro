---
import { safeCssLength } from './sanitize';

const { width = '100%', height = '1rem', shape = 'rounded' } = Astro.props;
const shapeClass = ({
  rounded: 'rounded-md',
  circle: 'rounded-full',
  square: 'rounded-none',
} as Record<string, string>)[shape as string] || 'rounded-md';
const sizeStyle = `width:${safeCssLength(width, '100%')};height:${safeCssLength(height, '1rem')};`;
---

<div class={`skeleton ${shapeClass}`} style={sizeStyle}></div>
