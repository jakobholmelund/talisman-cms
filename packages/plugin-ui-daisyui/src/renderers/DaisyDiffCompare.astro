---
const { beforeLabel = 'Before', afterLabel = 'After', beforeText, afterText } = Astro.props;
---

<div class="diff aspect-[16/9] w-full rounded-box border border-base-300 bg-base-100">
  <div class="diff-item-1">
    <div class="grid h-full place-content-center bg-base-200 p-6 text-center">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-base-content/60">{beforeLabel}</p>
        <p class="mt-2 text-sm">{beforeText}</p>
      </div>
    </div>
  </div>
  <div class="diff-item-2">
    <div class="grid h-full place-content-center bg-primary/10 p-6 text-center">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-base-content/60">{afterLabel}</p>
        <p class="mt-2 text-sm">{afterText}</p>
      </div>
    </div>
  </div>
  <div class="diff-resizer"></div>
</div>
