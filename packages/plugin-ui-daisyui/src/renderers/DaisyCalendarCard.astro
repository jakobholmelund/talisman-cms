---
const { month, days = [] } = Astro.props;
---

<div class="card border border-base-300 bg-base-100 shadow-sm">
  <div class="card-body gap-4">
    <h3 class="card-title text-base">{month}</h3>
    <div class="grid grid-cols-7 gap-2 text-center text-sm">
      {days.map((day: any) => (
        <div class={`rounded-box border px-2 py-3 ${day?.highlight ? 'border-primary bg-primary/10 text-primary' : 'border-base-300'}`}>
          <div class="font-semibold">{day?.label}</div>
          {day?.meta ? <div class="mt-1 text-xs text-base-content/60">{day.meta}</div> : null}
        </div>
      ))}
    </div>
  </div>
</div>
