---
import { safeHref } from './sanitize';

const { items = [], style = 'boxed' } = Astro.props;
const tabListClass = ({
  boxed: 'tabs-box',
  bordered: 'tabs-border',
  lifted: 'tabs-lift',
} as Record<string, string>)[style as string] || 'tabs-box';
---

<div role="tablist" class={`tabs ${tabListClass}`}>
  {items.map((item: any) => {
    const isDisabled = Boolean(item?.disabled);
    const href = safeHref(item?.href, '');
    const tabClass = ['tab', item?.active ? 'tab-active' : ''].filter(Boolean).join(' ');

    return href && !isDisabled ? (
      <a role="tab" href={href} class={tabClass}>{item.label}</a>
    ) : (
      <span role="tab" aria-disabled={isDisabled ? 'true' : undefined} class={tabClass}>{item?.label}</span>
    );
  })}
</div>
