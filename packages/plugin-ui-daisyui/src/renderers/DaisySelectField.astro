---
const { label, options = [], value, tone = 'primary' } = Astro.props;
const toneClass = ({
  primary: 'select-primary',
  secondary: 'select-secondary',
  accent: 'select-accent',
  neutral: 'select-neutral',
} as Record<string, string>)[tone as string] || 'select-primary';
---

<label class="form-control w-full max-w-sm gap-2">
  <span class="label-text">{label}</span>
  <select class={`select w-full ${toneClass}`}>
    {options.map((option: any) => (
      <option selected={option?.value === value} value={option?.value}>{option?.label}</option>
    ))}
  </select>
</label>
