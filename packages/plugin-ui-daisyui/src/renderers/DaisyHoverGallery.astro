---
const { items = [] } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-3">
  {items.map((item: any) => (
    <div class="hover-gallery rounded-box border border-base-300 bg-base-100 p-6 transition-transform hover:-translate-y-1">
      <h3 class="font-semibold">{item?.title}</h3>
      {item?.description ? <p class="mt-2 text-sm text-base-content/70">{item.description}</p> : null}
    </div>
  ))}
</div>
