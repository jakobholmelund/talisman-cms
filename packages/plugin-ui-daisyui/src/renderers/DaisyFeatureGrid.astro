---
import ComponentSlotRenderer from 'talisman-cms/render/ComponentSlotRenderer.astro';

const { title, description, items, componentRenderers, presetsById } = Astro.props;
---

<section class="space-y-8">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold">{title}</h2>
    {description ? <p class="mt-3 text-base-content/70">{description}</p> : null}
  </div>
  <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
    <ComponentSlotRenderer value={items} componentRenderers={componentRenderers} presetsById={presetsById} />
  </div>
</section>
