---
import { safeHref } from './sanitize';

const { imageUrl, alt = 'Phone preview', content } = Astro.props;
const imageSrc = safeHref(imageUrl, '');
---

<div class="mockup-phone border border-base-300">
  <div class="mockup-phone-camera"></div>
  <div class="mockup-phone-display">
    {imageSrc ? (
      <img src={imageSrc} alt={alt} class="h-full w-full object-cover" />
    ) : (
      <div class="grid h-full place-content-center bg-base-200 p-6 text-center text-sm text-base-content/70">{content}</div>
    )}
  </div>
</div>
