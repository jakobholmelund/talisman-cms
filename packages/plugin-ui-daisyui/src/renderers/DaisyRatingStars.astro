---
import { clampInteger } from './sanitize';

const { value = 3, max = 5, tone = 'primary' } = Astro.props;
const maskClass = ({
  primary: 'bg-primary',
  secondary: 'bg-secondary',
  accent: 'bg-accent',
  neutral: 'bg-neutral',
} as Record<string, string>)[tone as string] || 'bg-primary';
const starCount = clampInteger(max, 1, 10, 5);
---

<div class="rating">
  {Array.from({ length: starCount }).map((_: any, index: number) => (
    <input
      type="radio"
      class={`mask mask-star-2 ${maskClass}`}
      checked={index + 1 <= value}
      aria-label={`Rating ${index + 1}`}
    />
  ))}
</div>
