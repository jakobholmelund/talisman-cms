---
import { getClient } from 'talisman-cms/client';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';
import { buildThemeCss } from './theme-css';

const env = { DB: (cfEnv as any).DB, KV: (cfEnv as any).KV };

let injectedCss = '';
let lightThemeName = 'light';
let darkThemeName = 'dark';

try {
  const client = getClient(env as any);
  const themeGlobal = await client.globals.find('daisyui-theme');
  
  let data = themeGlobal?.data || {};
  if (typeof data === 'string') {
    try { data = JSON.parse(data); } catch (e) { data = {}; }
  }

  // Stored values are untrusted: buildThemeCss drops anything outside the colour/length allowlist.
  const theme = buildThemeCss(data);
  injectedCss = theme.css;
  lightThemeName = theme.lightTheme;
  darkThemeName = theme.darkTheme;
} catch (e) {
  console.error("DaisyUI Theme Injector Error: ", e);
}
---

{injectedCss.trim().length > 0 && <style is:inline set:html={injectedCss} />}

<script is:inline define:vars={{ lightThemeName, darkThemeName }}>
  window.talismanThemes = { light: lightThemeName, dark: darkThemeName };
  
  // Set initial theme based on localStorage or OS preference
  if (!document.documentElement.hasAttribute('data-theme')) {
    const savedTheme = localStorage.getItem('talisman-theme');
    if (savedTheme === 'light' || savedTheme === 'dark') {
      document.documentElement.setAttribute('data-theme', window.talismanThemes[savedTheme]);
    } else {
      const isDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      const initialMode = isDark ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', window.talismanThemes[initialMode]);
      localStorage.setItem('talisman-theme', initialMode);
    }
  }
</script>
