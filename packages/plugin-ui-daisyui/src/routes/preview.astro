---
import { getClient } from 'talisman-cms/client';
import { authorizeCmsRequest } from 'talisman-cms/auth/guard';
// @ts-ignore
import { adminPath } from 'virtual:talisman-cms/config';
// @ts-ignore
import { env as cfEnv } from 'cloudflare:workers';
import DaisyUiPreviewContent from '../components/DaisyUiPreviewContent.astro';
import DaisyUiThemeInjector from '../components/DaisyUiThemeInjector.astro';
import { sanitizeThemeSettings } from '../components/theme-css';

// The preview renders stored theme data on the site origin, so it is only for signed-in CMS users.
const authorization = await authorizeCmsRequest(Astro.request);
if (authorization.response) {
  return authorization.response.status === 401 ? Astro.redirect(adminPath) : authorization.response;
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

// Render inside a host layout so the preview uses the site's own Tailwind/daisyUI build.
const layouts = import.meta.glob('/src/layouts/*.astro', { eager: true });
const requestedLayoutPath = Astro.url.searchParams.get('layout');
const selectedLayoutPath = requestedLayoutPath && layouts[requestedLayoutPath] ? requestedLayoutPath : Object.keys(layouts)[0];
const LayoutComponent = selectedLayoutPath ? (layouts[selectedLayoutPath] as any).default : null;

// Determine current mode for the fallback preview layout
const mode = Astro.url.searchParams.get('mode') === 'dark' ? 'dark' : 'light';
let activeTheme: string = mode;

try {
  const env = { DB: (cfEnv as any).DB, KV: (cfEnv as any).KV };
  const client = getClient(env as any);
  const themeGlobal = await client.globals.find('daisyui-theme');
  let data = themeGlobal?.data || {};
  if (typeof data === 'string') {
    try { data = JSON.parse(data); } catch (e) { data = {}; }
  }

  const { settings } = sanitizeThemeSettings(data);
  activeTheme = mode === 'light' ? settings.lightTheme || 'light' : settings.darkTheme || 'dark';
} catch (e) {
  // DB not ready yet, keep defaults
}
---
{LayoutComponent && (
  <LayoutComponent title="Theme Preview">
    <DaisyUiThemeInjector />
    <div class="py-12 w-full max-w-7xl mx-auto px-4">
      <DaisyUiPreviewContent showAdminButton={true} />
    </div>
  </LayoutComponent>
)}

{!LayoutComponent && (
  <html lang="en" data-theme={activeTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>DaisyUI Theme Preview</title>
    <DaisyUiThemeInjector />
  </head>
  <body class="bg-base-100 text-base-content min-h-screen p-8 transition-colors duration-200">
    <p>No layout was found in <code>src/layouts</code>, so this preview has no site CSS. Add a layout that loads your Tailwind and daisyUI styles to see the theme applied.</p>
    <DaisyUiPreviewContent showAdminButton={true} />
  </body>
  </html>
)}
