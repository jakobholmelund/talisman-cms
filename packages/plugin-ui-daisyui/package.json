{
  "name": "@talisman-cms/plugin-ui-daisyui",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "description": "daisyUI page-builder plugin for Talisman CMS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator.d.ts",
      "import": "./dist/generator.js"
    },
    "./admin/*": "./src/admin/*",
    "./routes/*": "./src/routes/*",
    "./renderers/*": "./src/renderers/*",
    "./components/*": "./src/components/*"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/renderers",
    "src/admin",
    "src/routes",
    "src/components"
  ],
  "scripts": {
    "generate": "node ./scripts/catalog.mjs generate",
    "coverage": "node ./scripts/catalog.mjs coverage",
    "coverage:json": "node ./scripts/catalog.mjs coverage --json",
    "import-catalog": "node ./scripts/catalog.mjs import-catalog",
    "build": "pnpm run generate && tsup src/index.ts src/generator.ts src/generated.ts --format esm,cjs --dts",
    "dev": "pnpm run generate && tsup src/index.ts src/generator.ts src/generated.ts --format esm,cjs --dts --watch",
    "test": "pnpm run build && node --test ./test/*.test.mjs"
  },
  "dependencies": {
    "talisman-cms": "workspace:*"
  },
  "devDependencies": {
    "astro": "^7.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
