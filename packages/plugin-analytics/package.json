{
  "name": "@talisman-cms/plugin-analytics",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Cloudflare Web Analytics and optional Commerce reporting for Talisman CMS",
  "keywords": [
    "talisman-cms",
    "talisman-cms-plugin",
    "astro",
    "cloudflare",
    "cms",
    "analytics",
    "web-analytics"
  ],
  "homepage": "https://github.com/jakobholmelund/talisman-cms/tree/main/packages/plugin-analytics#readme",
  "bugs": {
    "url": "https://github.com/jakobholmelund/talisman-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakobholmelund/talisman-cms.git",
    "directory": "packages/plugin-analytics"
  },
  "author": "Jakob Holmelund",
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./beacon": "./src/Beacon.astro",
    "./admin/*": "./src/admin/*",
    "./admin/Analytics": "./src/admin/Analytics.tsx",
    "./admin/AskAnalytics": "./src/admin/AskAnalytics.tsx",
    "./admin/CommerceAnalytics": "./src/admin/CommerceAnalytics.tsx",
    "./admin/common": "./src/admin/common.tsx",
    "./tracking": {
      "types": "./dist/tracking.d.ts",
      "import": "./dist/tracking.js"
    },
    "./tracking/browser": {
      "types": "./dist/tracking-browser.d.ts",
      "import": "./dist/tracking-browser.js"
    },
    "./tracking/ga4": {
      "types": "./dist/tracking-ga4.d.ts",
      "import": "./dist/tracking-ga4.js"
    },
    "./tracking-ui": "./src/Tracking.astro"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/admin",
    "src/Beacon.astro",
    "NOTICE",
    "src/Tracking.astro"
  ],
  "scripts": {
    "build": "tsup src/tracking.ts src/tracking-browser.ts src/tracking-ga4.ts src/index.ts src/cloudflare.ts src/commerce.ts src/ask.ts src/routes/analytics-overview.ts src/routes/analytics-commerce.ts src/routes/analytics-ask.ts --format esm --dts --clean --external cloudflare:workers --external astro --external virtual:talisman-cms/config",
    "test": "pnpm build && node --experimental-sqlite --test test/*.test.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Publish with pnpm (pnpm release:publish) so workspace: ranges are rewritten and LICENSE.md is packed.'); process.exit(1); }\""
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "react": "^19.0.0",
    "talisman-cms": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "astro": "^7.4.12",
    "react": "^19.3.0",
    "talisman-cms": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
