{
  "name": "talisman-cms",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Astro Cloudflare CMS Integration",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "cloudflare",
    "cloudflare-workers",
    "d1",
    "cms",
    "headless-cms"
  ],
  "homepage": "https://github.com/jakobholmelund/talisman-cms/tree/main/packages/talisman-cms#readme",
  "bugs": {
    "url": "https://github.com/jakobholmelund/talisman-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakobholmelund/talisman-cms.git",
    "directory": "packages/talisman-cms"
  },
  "author": "Jakob Holmelund",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "ui",
    "drizzle",
    "seeds"
  ],
  "exports": {
    ".": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js"
    },
    "./ui-library-manifest": {
      "types": "./dist/ui-library-manifest.d.ts",
      "import": "./dist/ui-library-manifest.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./render/*": "./src/render/*",
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./db/media": {
      "types": "./dist/db/media.d.ts",
      "import": "./dist/db/media.js"
    },
    "./auth/dev": "./dist/auth/dev.js",
    "./auth/access": {
      "types": "./dist/auth/access.d.ts",
      "import": "./dist/auth/access.js"
    },
    "./auth/local": {
      "types": "./dist/auth/local.d.ts",
      "import": "./dist/auth/local.js"
    },
    "./auth/hybrid": {
      "types": "./dist/auth/hybrid.d.ts",
      "import": "./dist/auth/hybrid.js"
    },
    "./auth/identity": {
      "types": "./dist/auth/identity.d.ts",
      "import": "./dist/auth/identity.js"
    },
    "./auth/guard": {
      "types": "./dist/auth/guard.d.ts",
      "import": "./dist/auth/guard.js"
    },
    "./components/*": "./src/components/*",
    "./ui/*": "./ui/*"
  },
  "scripts": {
    "build:ts": "tsup",
    "build": "pnpm run build:ts",
    "test": "pnpm run build:ts && node --experimental-sqlite --test ./test/*.test.mjs",
    "dev:ts": "tsup --watch",
    "dev": "pnpm run build:ts && pnpm run dev:ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:list:local": "pnpm exec wrangler d1 migrations list DB --local --config ../../playground/wrangler.toml",
    "db:migrate:local": "pnpm exec wrangler d1 migrations apply DB --local --config ../../playground/wrangler.toml",
    "db:seed:ecommerce:local": "pnpm exec wrangler d1 execute DB --local --config ../../playground/wrangler.toml --file ./seeds/ecommerce-demo.sql",
    "prepublishOnly": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent || '')) { console.error('Publish with pnpm (pnpm release:publish) so workspace: ranges are rewritten and LICENSE.md is packed.'); process.exit(1); }\""
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/utils": "0.4.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/router-vite-plugin": "^1.167.40",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "1.7.5",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.577.0",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
