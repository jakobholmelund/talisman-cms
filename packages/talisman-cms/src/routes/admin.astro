---
// @ts-expect-error Types will be generated when building inside an actual Astro project
import type { APIRoute } from 'astro';
import { readSetting } from '../env';

// This is the shell for our React SPA
// In the future, we will render the React App here using a client:only directive or similar

// Commerce screens show money in the store currency (TALISMAN_COMMERCE_CURRENCY), scaled by its
// minor units. The commerce plugin checks the setting itself; here anything else reads as USD.
let commerceCurrency = 'usd';
try {
  const { env } = await import('cloudflare:workers');
  const configured = readSetting(env, 'COMMERCE_CURRENCY')?.toLowerCase();
  if (configured && /^[a-z]{3}$/.test(configured)) commerceCurrency = configured;
} catch {
  // Outside a Worker there are no settings to read.
}
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="talisman-commerce-currency" content={commerceCurrency}>
    <title>Talisman CMS</title>
</head>
<body class="bg-zinc-950 text-white">
    <div id="talisman-root"></div>
    
    <!-- Vite will bundle this index.tsx and serve the JS to the client -->
    <script>
      import "../../ui/index.tsx";
    </script>
</body>
</html>
